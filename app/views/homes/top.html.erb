<% if notice %>
  <p style="color: green;"><%= notice %></p>
<% end %>
<% if alert %>
  <p style="color: red;"><%= alert %></p>
<% end %>

<div class="hero-container">
  
  <%= image_tag "hero1.jpg", class: "hero-image", alt: "たびのあとメイン画像" %>

  <div class="hero-text">
    <h1>たびのあと (Tabinoato)</h1>
    <p>旅の思い出や足跡を記録・共有するWebアプリケーションです。</p>
  </div>
</div>

<section class="about-section">
  <h2>「たびのあと」でできること</h2>
  <p>旅行の思い出を写真やコメントと一緒に残したり、他のユーザーが行ったおすすめスポットをチェックできます。</p>
</section>