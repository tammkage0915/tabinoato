<% if authenticated? %>
  <div style="margin-bottom: 20px;">
    <%= form_with(url: posts_path, method: :get, local: true) do |f| %>
      <div style="display: flex; gap: 10px; align-items: center;">
        <%= f.text_field :keyword, value: params[:keyword], placeholder: "キーワードを入力（タイトル・場所・本文）", style: "padding: 8px; width: 300px;" %>

        <%= f.select :search_type, 
                     options_for_select([["部分一致", "partial"], ["完全一致", "exact"]], params[:search_type]), 
                     {}, 
                     style: "padding: 8px;" %>

        <%= f.submit "検索", style: "padding: 8px 15px;" %>

        <% if params[:keyword].present? %>
          <%= link_to "クリア", posts_path, style: "padding: 8px 12px; background-color: #eee; text-decoration: none; color: #333; border-radius: 4px;" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if params[:keyword].present? %>
    <p>
      「<%= params[:keyword] %>」の検索結果（<%= params[:search_type] == "exact" ? "完全一致" : "部分一致" %>）: <%= @posts.count %>件
    </p>
  <% end %>
<% else %>
  <p style="color: #666; font-size: 0.9em; margin-bottom: 20px;">
    ※ 投稿のキーワード検索機能を利用するには<%= link_to "ログイン", new_session_path %>が必要です。
  </p>
<% end %>

<h2>投稿一覧</h2>

<% if notice %>
  <p style="color: green;"><%= notice %></p>
<% end %>
<% if alert %>
  <p style="color: red;"><%= alert %></p>
<% end %>

<% if authenticated? %>
  <%= link_to "新規投稿を作成する", new_post_path %>
  <hr>
<% end %>

<% @posts.each do |post| %>
  <div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 10px;">
    <h3><%= link_to post.title, post_path(post) %></h3>
    <p><strong>投稿者:</strong> <%= post.user.name %></p>
    <p><strong>場所:</strong> <%= post.location_name %></p>
    <% if post.images.attached? %>
      <div style="display: flex; gap: 8px; margin: 10px 0;">
        <% post.images.first(2).each do |image| %>
          <%= image_tag image, style: "width: 150px; height: 100px; object-fit: cover; border-radius: 6px;" %>
        <% end %>

        <% if post.images.count > 2 %>
          <div style="width: 100px; height: 100px; background-color: rgba(0, 0, 0, 0.05); border-radius: 6px; display: flex; align-items: center; justify-content: center; font-weight: bold; color: #666;">
            +<%= post.images.count - 2 %>枚
          </div>
        <% end %>
      </div>
    <% end %>
    <p><%= truncate(post.body, length: 100) %></p>
    <p>💬 コメント: <%= post.comments.count %>件</p>
  </div>
<% end %>