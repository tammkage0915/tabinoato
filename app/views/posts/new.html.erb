<h2>新規投稿</h2>

<% if @post.errors.any? %>
  <div style="color: red;">
    <h3><%= @post.errors.count %>件のエラーが発生しました</h3>
    <ul>
      <% @post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @post do |f| %>
  <div>
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :location_name, "場所名" %><br>
    <%= f.text_field :location_name %>
  </div>

  <div>
    <%= f.label :address, "住所" %><br>
    <%= f.text_field :address %>
  </div>

  <div class="field">
    <%= f.label :images, "投稿画像（複数選択可）" %><br>
    <%= f.file_field :images, multiple: true, accept: "image/*" %>
  </div>

  <div>
    <%= f.label :body, "本文" %><br>
    <%= f.text_area :body, rows: 5 %>
  </div>

  <br>
  <div>
    <%= f.submit "投稿する" %>
  </div>
<% end %>

<br>
<%= link_to "投稿一覧へ戻る", posts_path %>