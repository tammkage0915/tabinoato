<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
  <h2 class="h3 fw-bold mb-0">
    <i class="fa-solid fa-heart text-danger me-2"></i>お気に入りした投稿
  </h2>
</div>

<% if @bookmark_posts.any? %>
  <div id="posts-grid" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <%= render partial: "public/posts/post", collection: @bookmark_posts %>
  </div>
<% else %>
  <div class="text-center text-muted py-5 my-5">
    <i class="fa-regular fa-heart fa-3x mb-3 opacity-50 d-block text-secondary"></i>
    <p class="fs-5 fw-semibold mb-1">お気に入りした投稿はまだありません</p>
    <p class="small text-muted mb-4">気になる投稿を見つけたらハートマークを押してお気に入りに追加してみましょう！</p>
    <%= link_to posts_path, class: "btn btn-outline-primary rounded-pill px-4 fw-semibold" do %>
      <i class="fa-solid fa-images me-1"></i>投稿一覧を見る
    <% end %>
  </div>
<% end %>