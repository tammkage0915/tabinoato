<div class="d-flex align-items-center gap-3 mb-3 small">
  <%= link_to post_path(@post), class: "text-decoration-none text-muted" do %>
    <i class="fa-solid fa-chevron-left me-1"></i>詳細へ戻る
  <% end %>
  <span class="text-muted">|</span>
  <%= link_to posts_path, class: "text-decoration-none text-muted" do %>
    <i class="fa-solid fa-images me-1"></i>投稿一覧へ戻る
  <% end %>
</div>

<div class="row justify-content-center">
  <div class="col-md-10 col-lg-8">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4 p-md-5">
        
        <h2 class="h3 fw-bold text-dark mb-4 border-bottom pb-3">
          <i class="fa-solid fa-pen-to-square text-primary me-2"></i>投稿の編集
        </h2>

        <% if @post.errors.any? %>
          <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <div class="fw-bold mb-2">
              <i class="fa-solid fa-triangle-exclamation me-2"></i><%= @post.errors.count %>件のエラーが発生しました
            </div>
            <ul class="mb-0 ps-3 small">
              <% @post.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>

        <%= form_with model: @post, local: true do |f| %>
          
          <div class="mb-3">
            <%= f.label :title, class: "form-label fw-semibold" do %>
              タイトル <span class="badge bg-danger ms-1">必須</span>
            <% end %>
            <%= f.text_field :title, class: "form-control", placeholder: "例：日帰り温泉旅行記" %>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <%= f.label :location_name, class: "form-label fw-semibold" do %>
                <i class="fa-solid fa-location-dot text-primary me-1"></i>場所名
              <% end %>
              <%= f.text_field :location_name, class: "form-control", placeholder: "例：駅前のカフェ / 山頂の景色" %>
            </div>

            <div class="col-md-6">
              <%= f.label :address, class: "form-label fw-semibold" do %>
                <i class="fa-solid fa-map-pin text-secondary me-1"></i>住所
              <% end %>
              <%= f.text_field :address, class: "form-control", placeholder: "例：○○県△△市" %>
            </div>
          </div>

          <div class="mb-4">
            <%= f.label :body, class: "form-label fw-semibold" do %>
              本文 <span class="badge bg-danger ms-1">必須</span>
            <% end %>
            <%= f.text_area :body, rows: 6, class: "form-control", placeholder: "旅の感想やおすすめスポット、見どころなどを自由に入力してください。" %>
          </div>

          <div class="d-flex flex-column flex-sm-row gap-2 pt-2 border-top">
            <%= f.submit "更新する", class: "btn btn-primary rounded-pill fw-semibold flex-grow-1 shadow-sm py-2" %>
            <%= link_to post_path(@post), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-outline-danger rounded-pill fw-semibold px-4 py-2" do %>
              <i class="fa-solid fa-trash-can me-1"></i>投稿を削除
            <% end %>
          </div>

        <% end %>

      </div>
    </div>
  </div>
</div>