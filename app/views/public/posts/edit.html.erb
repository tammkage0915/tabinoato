<h2>投稿編集</h2>

<% if @post.errors.any? %>
  <div style="color: red;">
    <h3><%= @post.errors.count %>件のエラーが発生しました</h3>
    <ul>
      <% @post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @post do |f| %>
  <div>
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :location_name, "場所名" %><br>
    <%= f.text_field :location_name %>
  </div>

  <div>
    <%= f.label :address, "住所" %><br>
    <%= f.text_field :address %>
  </div>

  <div>
    <%= f.label :body, "本文" %><br>
    <%= f.text_area :body, rows: 5 %>
  </div>

  <br>
  <div>
    <%= f.submit "更新する" %>
  </div>

  <div style="margin-top: 20px;">
    <%= link_to "削除", post_path(@post), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, style: "color: red;" %>
  </div>
<% end %>

<br>
<%= link_to "詳細へ戻る", post_path(@post) %> |
<%= link_to "投稿一覧へ戻る", posts_path %>