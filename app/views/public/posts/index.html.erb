<% if authenticated? %>
  <div class="card bg-light border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <%= form_with(url: posts_path, method: :get, local: true) do |f| %>
        <div class="row g-2 align-items-center">
          <div class="col-md-6 col-12">
            <div class="input-group">
              <span class="input-group-text bg-white text-muted border-end-0">
                <i class="fa-solid fa-magnifying-glass"></i>
              </span>
              <%= f.text_field :keyword, value: params[:keyword], placeholder: "タイトル・場所・本文で検索", class: "form-control border-start-0 ps-0" %>
            </div>
          </div>

          <div class="col-md-3 col-6">
            <%= f.select :search_type, 
                         options_for_select([["部分一致", "partial"], ["完全一致", "exact"]], params[:search_type]), 
                         {}, 
                         class: "form-select" %>
          </div>

          <div class="col-md-3 col-6 d-flex gap-2">
            <%= f.submit "検索", class: "btn btn-primary w-100 fw-semibold" %>
            <% if params[:keyword].present? %>
              <%= link_to "クリア", posts_path, class: "btn btn-outline-secondary" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% if params[:keyword].present? %>
    <div class="alert alert-info py-2 d-flex align-items-center" role="alert">
      <i class="fa-solid fa-circle-info me-2"></i>
      <div>
        「<strong><%= params[:keyword] %></strong>」の検索結果（<%= params[:search_type] == "exact" ? "完全一致" : "部分一致" %>）: <strong><%= @posts.total_count %></strong> 件
      </div>
    </div>
  <% end %>
<% else %>
  <div class="alert alert-light border text-muted mb-4 d-flex align-items-center" role="alert">
    <i class="fa-solid fa-lock me-2 text-primary"></i>
    <div>
      ※ 投稿のキーワード検索機能を利用するには <%= link_to "ログイン", new_session_path, class: "alert-link" %> が必要です。
    </div>
  </div>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
  <h2 class="h3 fw-bold mb-0">
    <i class="fa-solid fa-images text-primary me-2"></i>投稿一覧
  </h2>
  <% if authenticated? %>
    <%= link_to new_post_path, class: "btn btn-primary rounded-pill px-3 shadow-sm fw-semibold" do %>
      <i class="fa-solid fa-pen-to-square me-1"></i> 新規投稿を作成する
    <% end %>
  <% end %>
</div>

<div id="posts-grid" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
  <%= render partial: "public/posts/post", collection: @posts %>
</div>

<div id="load-more-button" class="text-center mt-5">
  <% unless @posts.last_page? %>
    <%= link_to posts_path(page: @posts.next_page, keyword: params[:keyword], search_type: params[:search_type]), 
                data: { turbo_stream: true }, 
                class: "btn btn-outline-primary rounded-pill px-5 py-2 fw-semibold shadow-sm" do %>
      <i class="fa-solid fa-angles-down me-1"></i>もっと見る
    <% end %>
  <% end %>
</div>