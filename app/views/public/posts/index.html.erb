<%# 検索フォームエリア %>
<% if authenticated? %>
  <div class="card bg-light border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <%= form_with(url: posts_path, method: :get, local: true) do |f| %>
        <div class="row g-2 align-items-center">
          <%# キーワード入力欄 %>
          <div class="col-md-6 col-12">
            <div class="input-group">
              <span class="input-group-text bg-white text-muted border-end-0">
                <i class="fa-solid fa-magnifying-glass"></i>
              </span>
              <%= f.text_field :keyword, value: params[:keyword], placeholder: "タイトル・場所・本文で検索", class: "form-control border-start-0 ps-0" %>
            </div>
          </div>

          <%# 検索条件セレクトボックス %>
          <div class="col-md-3 col-6">
            <%= f.select :search_type, 
                         options_for_select([["部分一致", "partial"], ["完全一致", "exact"]], params[:search_type]), 
                         {}, 
                         class: "form-select" %>
          </div>

          <%# ボタン類 %>
          <div class="col-md-3 col-6 d-flex gap-2">
            <%= f.submit "検索", class: "btn btn-primary w-100 fw-semibold" %>
            <% if params[:keyword].present? %>
              <%= link_to "クリア", posts_path, class: "btn btn-outline-secondary" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# 検索結果件数メッセージ %>
  <% if params[:keyword].present? %>
    <div class="alert alert-info py-2 d-flex align-items-center" role="alert">
      <i class="fa-solid fa-circle-info me-2"></i>
      <div>
        「<strong><%= params[:keyword] %></strong>」の検索結果（<%= params[:search_type] == "exact" ? "完全一致" : "部分一致" %>）: <strong><%= @posts.count %></strong> 件
      </div>
    </div>
  <% end %>
<% else %>
  <div class="alert alert-light border text-muted mb-4 d-flex align-items-center" role="alert">
    <i class="fa-solid fa-lock me-2 text-primary"></i>
    <div>
      ※ 投稿のキーワード検索機能を利用するには <%= link_to "ログイン", new_session_path, class: "alert-link" %> が必要です。
    </div>
  </div>
<% end %>

<%# 見出しと新規投稿ボタン %>
<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
  <h2 class="h3 fw-bold mb-0">
    <i class="fa-solid fa-images text-primary me-2"></i>投稿一覧
  </h2>
  <% if authenticated? %>
    <%= link_to new_post_path, class: "btn btn-primary rounded-pill px-3 shadow-sm fw-semibold" do %>
      <i class="fa-solid fa-pen-to-square me-1"></i> 新規投稿を作成する
    <% end %>
  <% end %>
</div>

<%# 投稿一覧（カードのグリッド表示） %>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
  <% @posts.each do |post| %>
    <div class="col">
      <div class="card h-100 shadow-sm hover-shadow transition">
        <%# 画像表示エリア %>
        <% if post.images.attached? %>
          <div class="position-relative">
            <%= image_tag post.images.first, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
            
            <%# 画像が複数ある場合の枚数バッジ %>
            <% if post.images.count > 1 %>
              <span class="position-absolute bottom-0 end-0 m-2 badge bg-dark bg-opacity-75 rounded-pill fs-7">
                <i class="fa-solid fa-camera me-1"></i><%= post.images.count %>枚
              </span>
            <% end %>
          </div>
        <% else %>
          <%# 画像がない場合のプレースホルダー %>
          <div class="card-img-top bg-light d-flex align-items-center justify-content-center text-muted" style="height: 200px;">
            <i class="fa-solid fa-image fa-2x"></i>
          </div>
        <% end %>

        <%# カード本文 %>
        <div class="card-body d-flex flex-column">
          <%# 場所情報 %>
          <% if post.location_name.present? %>
            <div class="text-primary small fw-semibold mb-1">
              <i class="fa-solid fa-location-dot me-1"></i><%= post.location_name %>
            </div>
          <% end %>

          <%# タイトル %>
          <h5 class="card-title fw-bold mb-2">
            <%= link_to post.title, post_path(post), class: "text-decoration-none text-dark stretched-link" %>
          </h5>

          <%# 本文チラ見せ %>
          <p class="card-text text-muted small flex-grow-1">
            <%= truncate(post.body, length: 70) %>
          </p>
        </div>

        <%# カードフッター（投稿者情報＆コメント数） %>
        <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center text-muted small py-3">
          <div class="d-flex align-items-center">
            <i class="fa-solid fa-circle-user me-1 text-secondary"></i>
            <span><%= post.user.name %></span>
          </div>
          <div>
            <i class="fa-regular fa-comment me-1"></i><%= post.comments.count %>件
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>