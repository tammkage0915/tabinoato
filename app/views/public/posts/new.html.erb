<div class="mb-3">
  <%= link_to posts_path, class: "text-decoration-none text-muted small" do %>
    <i class="fa-solid fa-chevron-left me-1"></i>投稿一覧へ戻る
  <% end %>
</div>

<div class="row justify-content-center">
  <div class="col-md-10 col-lg-8">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4 p-md-5">
        
        <h2 class="h3 fw-bold text-dark mb-4 border-bottom pb-3">
          <i class="fa-solid fa-pen-to-square text-primary me-2"></i>新規投稿を作成
        </h2>

        <% if @post.errors.any? %>
          <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <div class="fw-bold mb-2">
              <i class="fa-solid fa-triangle-exclamation me-2"></i><%= @post.errors.count %>件のエラーが発生しました
            </div>
            <ul class="mb-0 ps-3 small">
              <% @post.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>

        <%= form_with model: @post, local: true do |f| %>
          
          <div class="mb-3">
            <%= f.label :title, class: "form-label fw-semibold" do %>
              タイトル <span class="badge bg-danger ms-1">必須</span>
            <% end %>
            <%= f.text_field :title, class: "form-control", placeholder: "例：日帰り温泉旅行記" %>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <%= f.label :location_name, class: "form-label fw-semibold" do %>
                <i class="fa-solid fa-location-dot text-primary me-1"></i>場所名
              <% end %>
              <%= f.text_field :location_name, class: "form-control", placeholder: "例：駅前のカフェ / 山頂の景色" %>
            </div>

            <div class="col-md-6">
              <%= f.label :address, class: "form-label fw-semibold" do %>
                <i class="fa-solid fa-map-pin text-secondary me-1"></i>住所
              <% end %>
              <%= f.text_field :address, class: "form-control", placeholder: "例：○○県△△市" %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :images, class: "form-label fw-semibold" do %>
              <i class="fa-regular fa-images text-success me-1"></i>投稿画像（複数選択可）
            <% end %>
            <%= f.file_field :images, multiple: true, accept: "image/*", class: "form-control" %>
            <div class="form-text">旅の思い出写真を複数枚選択できます。</div>
          </div>

          <div class="mb-4">
            <%= f.label :body, class: "form-label fw-semibold" do %>
              本文 <span class="badge bg-danger ms-1">必須</span>
            <% end %>
            <%= f.text_area :body, rows: 6, class: "form-control", placeholder: "旅の感想やおすすめスポット、見どころなどを自由に入力してください。" %>
          </div>

          <div class="d-grid gap-2">
            <%= f.submit "投稿する", class: "btn btn-primary btn-lg rounded-pill fw-semibold shadow-sm" %>
          </div>

        <% end %>

      </div>
    </div>
  </div>
</div>