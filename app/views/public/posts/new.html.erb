<div class="mb-3">
  <%= link_to posts_path, class: "text-decoration-none text-muted small" do %>
    <i class="fa-solid fa-chevron-left me-1"></i>投稿一覧へ戻る
  <% end %>
</div>

<div class="row justify-content-center">
  <div class="col-md-10 col-lg-8">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4 p-md-5">
        
        <h2 class="h3 fw-bold text-dark mb-4 border-bottom pb-3">
          <i class="fa-solid fa-pen-to-square text-primary me-2"></i>新規投稿を作成
        </h2>

        <%= render "public/posts/form", post: @post %>

      </div>
    </div>
  </div>
</div>