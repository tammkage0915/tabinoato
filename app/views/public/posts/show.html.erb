<h2>投稿詳細</h2>

<% if notice %>
  <p style="color: green;"><%= notice %></p>
<% end %>

<div>
  <h3><%= @post.title %></h3>
  <p><strong>投稿者:</strong> <%= link_to @post.user.name, user_path(@post.user) %></p>
  <p><strong>場所名:</strong> <%= @post.location_name %></p>
  <p><strong>住所:</strong> <%= @post.address %></p>
  <% if @post.images.attached? %>
    <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 15px;">
      <% @post.images.each do |image| %>
        <%= image_tag image, style: "width: 200px; height: 150px; object-fit: cover; border-radius: 8px;" %>
      <% end %>
    </div>
  <% end %>
  <p><strong>本文:</strong></p>
  <p><%= simple_format(@post.body) %></p>
</div>

<% if authenticated? && Current.user == @post.user %>
  <div>
    <%= link_to "編集", edit_post_path(@post) %> | 
    <%= link_to "削除", post_path(@post), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
  </div>
<% end %>

<hr style="margin: 30px 0;">

<h3>コメント一覧 (<%= @comments.count %>件)</h3>

<% if @comments.any? %>
  <div style="margin-bottom: 20px;">
    <% @comments.each do |comment| %>
      <div style="border-bottom: 1px solid #eee; padding: 10px 0;">
        <p style="font-size: 0.9em; color: #555; margin-bottom: 5px;">
          <strong><%= comment.user&.name %></strong>
          <span style="font-size: 0.8em; color: #999;">(<%= comment.created_at.strftime("%Y/%m/%d %H:%M") %>)</span>
        </p>
        <p style="margin: 0;"><%= simple_format(comment.body) %></p>

        <% if authenticated? && comment.user == Current.user %>
          <div style="text-align: right;">
            <%= link_to "削除", post_comment_path(@post, comment), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, style: "color: red; font-size: 0.8em;" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <p style="color: #888;">まだコメントはありません。</p>
<% end %>

<% if authenticated? %>
  <h4>コメントを投稿する</h4>
  <%= form_with(model: [@post, @comment], local: true) do |f| %>
    <div style="margin-bottom: 10px;">
      <%= f.text_area :body, rows: 3, style: "width: 100%; max-width: 500px; padding: 8px;", placeholder: "コメントを入力してください" %>
    </div>
    <%= f.submit "送信", style: "padding: 8px 16px;" %>
  <% end %>
<% else %>
  <p style="color: #666; font-size: 0.9em;">
    ※ コメントを投稿するには<%= link_to "ログイン", login_path %>が必要です。
  </p>
<% end %>

<br>
<%= link_to "投稿一覧へ戻る", posts_path %>