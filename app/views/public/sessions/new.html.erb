<h2>ログイン</h2>

<% if flash[:alert] %>
  <div style="color: red;">
    <%= flash[:alert] %>
  </div>
<% end %>

<%= form_with url: session_path do |f| %>
  <div>
    <%= f.label :name, "名前" %><br>
    <%= f.text_field :name, value: params[:name], required: true, autofocus: true %>
  </div>

  <div>
    <%= f.label :password, "パスワード" %><br>
    <%= f.password_field :password, required: true %>
  </div>

  <br>
  <div>
    <%= f.submit "ログイン" %>
  </div>
<% end %>
