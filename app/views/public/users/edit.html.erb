<h2>プロフィール編集</h2>

<% if @user.errors.any? %>
  <div style="color: red;">
    <h3><%= @user.errors.count %>件のエラーが発生しました</h3>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: update_user_information_path, method: :patch do |f| %>
  <div>
    <%= f.label :name, "名前" %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :email_address, "メールアドレス" %><br>
    <%= f.email_field :email_address %>
  </div>

  <div class="field">
    <%= f.label :profile_image, "プロフィール画像" %>
    <%= f.file_field :profile_image, accept: "image/*" %>
  </div>

  <div style="margin: 10px 0;">
  <% if @user.profile_image.attached? %>
    <%= image_tag @user.profile_image, id: "image-preview", style: "width: 100px; height: 100px; object-fit: cover; border-radius: 50%;" %>
  <% else %>
    <%= image_tag "no_image.jpg", id: "image-preview", style: "width: 100px; height: 100px; object-fit: cover; border-radius: 50%;" %>
  <% end %>
</div>

  <br>
  <div>
    <%= f.submit "更新する" %>
  </div>
<% end %>

<br>
<%= link_to "マイページに戻る", mypage_path %>