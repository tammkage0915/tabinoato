<div class="row justify-content-center my-4">
  <div class="col-md-8 col-lg-6">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4 p-md-5">
        
        <h2 class="h3 fw-bold text-dark text-center mb-4 border-bottom pb-3">
          <i class="fa-solid fa-user-plus text-primary me-2"></i>新規会員登録
        </h2>

        <% if @user.errors.any? %>
          <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <div class="fw-bold mb-2">
              <i class="fa-solid fa-triangle-exclamation me-2"></i><%= @user.errors.count %>件のエラーが発生しました
            </div>
            <ul class="mb-0 ps-3 small">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>

        <%= form_with model: @user, url: users_path, local: true, data: { turbo: false } do |f| %>
          
          <div class="mb-3">
            <%= f.label :name, class: "form-label fw-semibold" do %>
              名前 <span class="badge bg-danger ms-1">必須</span>
            <% end %>
            <div class="input-group">
              <span class="input-group-text bg-light text-muted">
                <i class="fa-solid fa-user"></i>
              </span>
              <%= f.text_field :name, class: "form-control", placeholder: "お名前またはユーザー名" %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :email_address, class: "form-label fw-semibold" do %>
              メールアドレス <span class="badge bg-danger ms-1">必須</span>
            <% end %>
            <div class="input-group">
              <span class="input-group-text bg-light text-muted">
                <i class="fa-regular fa-envelope"></i>
              </span>
              <%= f.email_field :email_address, class: "form-control", placeholder: "example@example.com" %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :password, class: "form-label fw-semibold" do %>
              パスワード <span class="badge bg-danger ms-1">必須</span>
            <% end %>
            <div class="input-group">
              <span class="input-group-text bg-light text-muted">
                <i class="fa-solid fa-lock"></i>
              </span>
              <%= f.password_field :password, class: "form-control", placeholder: "パスワードを入力" %>
            </div>
          </div>

          <div class="mb-4">
            <%= f.label :password_confirmation, class: "form-label fw-semibold" do %>
              パスワード（確認） <span class="badge bg-danger ms-1">必須</span>
            <% end %>
            <div class="input-group">
              <span class="input-group-text bg-light text-muted">
                <i class="fa-solid fa-lock-open"></i>
              </span>
              <%= f.password_field :password_confirmation, class: "form-control", placeholder: "もう一度パスワードを入力" %>
            </div>
          </div>

          <div class="d-grid gap-2 pt-2">
            <%= f.submit "新規登録", class: "btn btn-primary rounded-pill fw-semibold shadow-sm py-2 fs-6" %>
          </div>

        <% end %>

        <div class="text-center mt-4 pt-3 border-top">
          <p class="small text-muted mb-0">
            すでにアカウントをお持ちですか？
            <%= link_to "ログインはこちら", new_session_path, class: "fw-semibold text-decoration-none ms-1" %>
          </p>
        </div>

      </div>
    </div>
  </div>
</div>