<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
  <h2 class="h3 fw-bold mb-0 text-dark">
    <% if @user == Current.user %>
      <i class="fa-solid fa-user text-primary me-2"></i>マイページ
    <% else %>
      <i class="fa-solid fa-user text-primary me-2"></i><%= @user.name %> さんのプロフィール
    <% end %>
  </h2>
</div>

<div class="card shadow-sm border-0 mb-5">
  <div class="card-body p-4">
    <div class="row align-items-center g-4">
      
      <div class="col-12 col-md-auto text-center">
        <% if @user.profile_image.attached? %>
          <%= image_tag @user.profile_image, class: "rounded-circle shadow-sm", style: "width: 110px; height: 110px; object-fit: cover;" %>
        <% else %>
          <%= image_tag "no_image.jpg", class: "rounded-circle shadow-sm", style: "width: 110px; height: 110px; object-fit: cover;" %>
        <% end %>
      </div>

      <div class="col-12 col-md">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
          <div>
            <h3 class="h4 fw-bold text-dark mb-1"><%= @user.name %></h3>
            <% if @user == Current.user %>
              <div class="text-muted small">
                <i class="fa-regular fa-envelope me-1"></i><%= @user.email_address %>
              </div>
            <% end %>
          </div>

          <% if @user == Current.user %>
            <%= link_to edit_user_information_path, class: "btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold" do %>
              <i class="fa-solid fa-user-pen me-1"></i>プロフィールを編集
            <% end %>
          <% end %>
        </div>

        <div class="d-flex gap-3 mt-3 pt-3 border-top text-muted small">
          <div>
            <i class="fa-solid fa-images text-primary me-1"></i>
            投稿数: <strong class="text-dark fs-6"><%= @posts.count %></strong> 件
          </div>
          <% if @user == Current.user %>
            <div>
              <i class="fa-regular fa-comments text-success me-1"></i>
              コメント数: <strong class="text-dark fs-6"><%= @user.comments.count %></strong> 件
            </div>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>

<div class="mb-4">
  <h3 class="h5 fw-bold text-dark mb-3">
    <i class="fa-solid fa-map-location-dot text-primary me-2"></i>
    <%= @user == Current.user ? "自分の投稿一覧" : "#{@user.name} さんの投稿一覧" %>
  </h3>

  <% if @posts.any? %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% @posts.each do |post| %>
        <div class="col">
          <div class="card h-100 shadow-sm border-0">
            <% if post.images.attached? %>
              <%= image_tag post.images.first, class: "card-img-top", style: "height: 180px; object-fit: cover;" %>
            <% else %>
              <div class="card-img-top bg-light d-flex align-items-center justify-content-center text-muted" style="height: 180px;">
                <i class="fa-solid fa-image fa-2x"></i>
              </div>
            <% end %>

            <div class="card-body d-flex flex-column">
              <% if post.location_name.present? %>
                <div class="text-primary small fw-semibold mb-1">
                  <i class="fa-solid fa-location-dot me-1"></i><%= post.location_name %>
                </div>
              <% end %>

              <h4 class="h6 card-title fw-bold mb-2">
                <%= link_to post.title, post_path(post), class: "text-decoration-none text-dark stretched-link" %>
              </h4>

              <p class="card-text text-muted small flex-grow-1 mb-3">
                <%= truncate(post.body, length: 60) %>
              </p>

              <div class="text-muted extra-small mt-auto pt-2 border-top" style="font-size: 0.8rem;">
                <i class="fa-regular fa-clock me-1"></i><%= post.created_at.strftime("%Y/%m/%d %H:%M") %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card bg-light border-0 py-5 text-center text-muted">
      <i class="fa-solid fa-folder-open fa-3x mb-3 opacity-50"></i>
      <p class="mb-0">まだ投稿がありません。</p>
    </div>
  <% end %>
</div>

<% if @user == Current.user %>
  <div class="mt-5 pt-4 border-top text-end">
    <%= link_to unsubscribe_user_information_path, class: "text-danger small text-decoration-none" do %>
      <i class="fa-solid fa-triangle-exclamation me-1"></i>退会手続きへ進む
    <% end %>
  </div>
<% end %>