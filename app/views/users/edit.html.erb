<h2>プロフィール編集</h2>

<% if @user.errors.any? %>
  <div style="color: red;">
    <h3><%= @user.errors.count %>件のエラーが発生しました</h3>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: update_user_information_path, method: :patch do |f| %>
  <div>
    <%= f.label :name, "名前" %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :email_address, "メールアドレス" %><br>
    <%= f.email_field :email_address %>
  </div>

  <br>
  <div>
    <%= f.submit "更新する" %>
  </div>
<% end %>

<br>
<%= link_to "マイページに戻る", mypage_path %>